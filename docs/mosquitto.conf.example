# Animat 开发用 mosquitto 配置（支持 TCP + WebSocket 双传输）
# 用途：让网页调试模拟客户端（animat/simulator_web.html）通过 WebSocket 连接。
#
# 启动方式（任选其一）：
#   mosquitto -c docs/mosquitto.conf.example -v
#   docker run -it -p 1883:1883 -p 8083:8083 eclipse-mosquitto \
#       mosquitto -c /mosquitto/config/mosquitto.conf   # 容器内已含 ws 配置时

# ── 监听器 ──
# TCP（主进程 & 终端模拟器使用，默认端口 1883）
listener 1883 0.0.0.0
protocol mqtt

# WebSocket（网页客户端使用，端口 8083，路径 /mqtt）
listener 8083 0.0.0.0
protocol websockets

# ── 持久化 & 日志 ──
persistence false
log_dest stdout

# ── 允许匿名（开发环境）──
allow_anonymous true
