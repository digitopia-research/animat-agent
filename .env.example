# ── LLM 配置 ──
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
ANIMAT_LLM_MODEL=gpt-4o-mini

# ── MQTT Broker ──
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
# Transport: "tcp" (default, port 1883) or "websockets" (e.g. port 8083)
MQTT_TRANSPORT=tcp
# WebSocket path (only used when MQTT_TRANSPORT=websockets)
MQTT_WS_PATH=/mqtt

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
