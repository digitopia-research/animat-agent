# ── LLM 配置 ──
# 后端选择: local = 本地 GGUF 模型 (llama-cpp-python)；cloud = OpenAI 兼容云端 API
ANIMAT_LLM_BACKEND=local

# 云端后端需要以下三项 (ANIMAT_LLM_BACKEND=cloud 时生效)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
ANIMAT_LLM_MODEL=gpt-4o-mini

# ── 本地 LLM 后端 (ANIMAT_LLM_BACKEND=local 时生效) ──
# GGUF 模型路径 (改成你机器上的绝对路径)
#   显存占用参考 (权重 + KV Cache @ n_ctx=4096, 全部卸载到 GPU):
#     Qwen2.5-1.5B-Instruct-Q4_K_M.gguf  ~1.3 GB   最快, 质量一般, 工具调用基本不可用
#     Qwen2.5-7B-Instruct-Q4_K_M.gguf    ~5.6 GB   独白连贯, 工具调用较弱
#     Qwen3-8B-Instruct-Q4_K_M.gguf      ~5.5 GB   中文自然, 工具调用中等
#     Qwen3-14B-Q4_K_M.gguf              ~14.8 GB  推荐: 工具调用可用 (需 16GB 卡)
ANIMAT_MODEL_PATH=/root/Workspace/animat-agent/models/Qwen3-14B-Q4_K_M.gguf
# 上下文窗口 (显存不够时优先调这个: 4096 → 2048 可省约一半 KV Cache)
# 注意: 工具 schema 本身约占 600 token，配合回注结果，不建议低于 4096
ANIMAT_N_CTX=4096
# 单轮思维输出上限。工具调用需额外空间生成 <tool_call> JSON，建议 >=512。
ANIMAT_MAX_THINK_TOKENS=768
# CPU 推理线程数 (GPU 全卸载后可适当调低，如 4)
ANIMAT_N_THREADS=4
# GPU 卸载层数 — 不设置(保持注释)时自动探测:
#   探测到 NVIDIA GPU → 全卸载 (99 层, llama.cpp 会按模型实际层数截断)
#   未探测到          → 纯 CPU (0)
# 显式设置会覆盖自动探测: 0 = 强制纯 CPU；99 = 强制全卸载。
# 注意: 需要带 CUDA 编译的 llama-cpp-python，否则设了也会回退 CPU。
# ANIMAT_N_GPU_LAYERS=99

# ── 工具调用 (LLM tool calling) ──
# 总开关: 0 关闭全部工具，模型退化为纯文本对话
ANIMAT_TOOLS=1

# 联网搜索工具 web_search 使用 DeepSeek 搜索 API
# 文档: https://api-docs.deepseek.com/zh-cn/guides/search
# 计费: 5 元 / 1000 次成功请求
DEEPSEEK_API_KEY=
# 每日搜索调用上限，防止费用失控
ANIMAT_SEARCH_MAX_PER_DAY=200
# 单次搜索超时（秒），超时返回空结果，不阻塞思维循环
ANIMAT_SEARCH_TIMEOUT=8
# 回注给模型的搜索结果体积（太大容易撑爆 n_ctx）
ANIMAT_SEARCH_MAX_RESULTS=2
ANIMAT_SNIPPET_MAX_CHARS=180

# 主动呼唤(call)冷却期（秒）：同一诉求在该窗口内不重复对外发声
ANIMAT_CALL_COOLDOWN=60

# ── MQTT Broker ──
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
# Transport: "tcp" (default, port 1883) or "websockets" (e.g. port 8083)
MQTT_TRANSPORT=tcp
# WebSocket path (only used when MQTT_TRANSPORT=websockets)
MQTT_WS_PATH=/mqtt

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
