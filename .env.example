# ── LLM 配置 ──
# 后端选择: local = 本地 GGUF 模型 (llama-cpp-python)；cloud = OpenAI 兼容云端 API
ANIMAT_LLM_BACKEND=local

# 云端后端需要以下三项 (ANIMAT_LLM_BACKEND=cloud 时生效)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
ANIMAT_LLM_MODEL=gpt-4o-mini

# ── 本地 LLM 后端 (ANIMAT_LLM_BACKEND=local 时生效) ──
# GGUF 模型路径 (改成你机器上的绝对路径)
#   显存占用参考 (权重 + KV Cache @ n_ctx=4096, 全部卸载到 GPU):
#     Qwen2.5-1.5B-Instruct-Q4_K_M.gguf  ~1.3 GB   最快 (~70 tok/s), 质量一般
#     Qwen2.5-7B-Instruct-Q3_K_M.gguf    ~4.7 GB   显存紧张时的折中, 质量有可见损失
#     Qwen2.5-7B-Instruct-Q4_K_M.gguf    ~5.6 GB   推荐 (~40 tok/s), 独白连贯 / JSON 稳定
ANIMAT_MODEL_PATH=/root/Workspace/animat-agent/models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
# 上下文窗口 (显存不够时优先调这个: 4096 → 2048 可省约一半 KV Cache)
ANIMAT_N_CTX=4096
# CPU 推理线程数 (GPU 全卸载后可适当调低，如 4)
ANIMAT_N_THREADS=4
# GPU 卸载层数 — 不设置(保持注释)时自动探测:
#   探测到 NVIDIA GPU → 全卸载 (99 层, llama.cpp 会按模型实际层数截断)
#   未探测到          → 纯 CPU (0)
# 显式设置会覆盖自动探测: 0 = 强制纯 CPU；99 = 强制全卸载。
# 注意: 需要带 CUDA 编译的 llama-cpp-python，否则设了也会回退 CPU。
# ANIMAT_N_GPU_LAYERS=99

# ── MQTT Broker ──
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
# Transport: "tcp" (default, port 1883) or "websockets" (e.g. port 8083)
MQTT_TRANSPORT=tcp
# WebSocket path (only used when MQTT_TRANSPORT=websockets)
MQTT_WS_PATH=/mqtt

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
